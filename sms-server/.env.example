# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram ──────────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram (takes ~30 seconds):
#   1. Open Telegram, search for @BotFather
#   2. Send /newbot
#   3. Choose a name (e.g. "My Vita Bot") and username (e.g. "myvita_bot")
#   4. Copy the token it gives you here
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the data directory. The directory must exist before starting.
# Default: ./data  (relative to sms-server/)
# DB_PATH=./data/vita.db
